  "license": "ISC",
  "devDependencies": {
    "glob": "^11.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "easymde": "^2.21.0"
  }
