{
  "name": "bdsmv2.0",
  "version": "1.0.0",
  "description": "Foxsir 欲研所 v2.0 项目（启动器 / 管理后台 / 各模块 / 共享层）",
  "main": "src/launcher/index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/flatten-dist.mjs",
    "preview": "vite preview",

    "serve": "node tools/static-server.mjs",
    "serve:dist": "node tools/static-server.mjs --dist --port 5601",

    "check": "node tools/ref-check.mjs",
    "check:baseline": "node tools/ref-check.mjs --baseline",
    "refs": "node tools/show-refs.mjs",

    "smoke": "node tools/smoke.mjs",
    "smoke:dist": "node tools/smoke.mjs --port 5601 --prod --label \"dist 生产态\"",
    "crawl": "node tools/crawl.mjs",
    "runtime": "node tools/runtime-check.mjs",
    "runtime:dist": "node tools/runtime-check.mjs --port 5601",
    "shots": "node tools/runtime-check.mjs --port 5601 --shot --wait 3000",

    "check:menu": "node tools/check-menu.mjs",
    "check:auth": "node tools/check-auth-flow.mjs",
    "check:avatar": "node tools/check-avatar-upload.mjs",

    "flatten": "node tools/flatten-dist.mjs",
    "verify": "npm run check && npm run build && npm run smoke:dist",
    "verify:full": "npm run check && npm run build && npm run smoke:dist && npm run runtime:dist && npm run check:menu -- --port 5601"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "glob": "^11.0.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "easymde": "^2.21.0"
  }
}
